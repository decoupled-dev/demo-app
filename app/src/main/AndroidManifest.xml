<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- HVAC and standard vehicle properties via CarPropertyManager (signature|privileged). -->
    <!-- Active media source, same permission the car launcher media widget uses. -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
    <uses-permission android:name="android.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="android.car.permission.CONTROL_CAR_DISPLAY_UNITS" />
    <uses-permission android:name="android.car.permission.READ_CAR_DISPLAY_UNITS" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <uses-permission android:name="android.car.permission.CAR_MILEAGE" />
    <uses-permission android:name="android.car.permission.CAR_TIRES" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />

    <!-- Home media widget opens whichever app is the active playback source. -->
    <queries>
        <intent>
            <action android:name="android.car.intent.action.MEDIA_TEMPLATE" />
        </intent>
        <package android:name="com.android.car.media" />
    </queries>

    <application
        android:name=".DesignApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Design">

        <!-- On Baklava+ AAOS, android.car is on the boot classpath and is not always
             registered as a PackageManager shared library; required=false allows install. -->
        <uses-library
            android:name="android.car"
            android:required="false" />

        <!-- Avoid androidx.startup crash: library R$string is not packaged into dex (AGP). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:taskAffinity="com.test.design.main"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:theme="@style/Theme.Design"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_AUTOMOTIVE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".presentation.ivi.map.MapActivity"
            android:exported="true"
            android:label="@string/map_activity_name"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:taskAffinity="com.test.design.map"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:theme="@style/Theme.Design"
            android:windowSoftInputMode="adjustResize">
            <!-- Launcher + AAOS map role (separate task from MainActivity) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_AUTOMOTIVE" />
                <category android:name="android.intent.category.APP_MAPS" />
            </intent-filter>
            <!-- Direct launch from Scalable UI actions or in-app code -->
            <intent-filter>
                <action android:name="com.test.design.action.OPEN_MAP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Display map at a geo location -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="geo" />
            </intent-filter>
            <!-- Turn-by-turn navigation entry -->
            <intent-filter>
                <action android:name="androidx.car.app.action.NAVIGATE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="geo" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <!-- Assistant UI — same affinity as MainActivity so AAOS places it on the visible app panel. -->
        <activity
            android:name=".presentation.assistant.VirtualAssistantActivity"
            android:exported="true"
            android:label="@string/assistant_activity_name"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:taskAffinity="com.test.design.main"
            android:launchMode="singleTop"
            android:excludeFromRecents="false"
            android:allowTaskReparenting="false"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:theme="@style/Theme.Design.AssistantStandalone"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_AUTOMOTIVE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.test.design.action.OPEN_ASSISTANT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <activity
            android:name=".presentation.assistant.gallery.AssistantUiGalleryActivity"
            android:exported="true"
            android:label="Assistant UI gallery"
            android:theme="@style/Theme.Design.AssistantOverlay"
            android:excludeFromRecents="true"
            android:taskAffinity="com.test.design.main"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_AUTOMOTIVE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.test.design.action.OPEN_ASSISTANT_GALLERY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <activity
            android:name=".presentation.assistant.overlay.AssistantOverlayBootstrapActivity"
            android:exported="true"
            android:label="@string/assistant_activity_name"
            android:theme="@style/Theme.Design.AssistantOverlay"
            android:excludeFromRecents="true"
            android:taskAffinity="com.test.design.main"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="com.test.design.action.START_ASSISTANT_OVERLAY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <service
            android:name=".presentation.assistant.overlay.AssistantOverlayService"
            android:exported="true"
            android:enabled="true" />

        <!-- Translucent immersive assistant over any app (standalone launch path). -->
        <service
            android:name=".presentation.assistant.ImmersiveAssistantOverlayService"
            android:exported="false"
            android:enabled="true" />

        <!-- ADB show/hide for in-app floating system bars -->
        <receiver
            android:name=".presentation.ivi.dashboard.FloatingSystemBarsReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.test.design.action.SHOW_SYSTEM_BARS" />
                <action android:name="com.test.design.action.HIDE_SYSTEM_BARS" />
                <action android:name="com.test.design.action.TOGGLE_SYSTEM_BARS" />
                <action android:name="com.test.design.action.SET_SYSTEM_BARS" />
            </intent-filter>
        </receiver>

        <!-- ADB swap immersive assistant face (none|eyes|eporo|droid|glyph) -->
        <receiver
            android:name=".presentation.assistant.AssistantFaceReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.test.design.action.SET_ASSISTANT_FACE" />
                <action android:name="com.test.design.action.GET_ASSISTANT_FACE" />
            </intent-filter>
        </receiver>

        <!-- Dewd widget_panel host (left rail) -->
        <activity
            android:name=".presentation.ivi.glanceables.DrivingRailActivity"
            android:exported="true"
            android:label="Driving rail"
            android:taskAffinity="com.test.design.widget"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Design.Panel"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
        <!-- Same-length alias for binary patch of DewdDynamic widget_component string -->
        <activity-alias
            android:name=".presentation.ivi.glanceables.R"
            android:targetActivity=".presentation.ivi.glanceables.DrivingRailActivity"
            android:exported="true"
            android:label="Driving rail">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity-alias>
        <!-- Optional standalone glanceables (debug / alternate layouts) -->
        <activity
            android:name=".presentation.ivi.glanceables.DrivingStatusGlanceActivity"
            android:exported="true"
            android:label="Driving status"
            android:taskAffinity="com.test.design.glance.driving"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Design.Panel"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
        <activity
            android:name=".presentation.ivi.glanceables.MediaGlanceActivity"
            android:exported="true"
            android:label="Media"
            android:taskAffinity="com.test.design.glance.media"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Design.Panel"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
        <activity
            android:name=".presentation.ivi.glanceables.AppsGlanceActivity"
            android:exported="true"
            android:label="Apps"
            android:taskAffinity="com.test.design.glance.apps"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Design.Panel"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
        <activity
            android:name=".presentation.ivi.glanceables.ClimateGlanceActivity"
            android:exported="true"
            android:label="Climate"
            android:taskAffinity="com.test.design.glance.climate"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Design.Panel"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
        <activity
            android:name=".presentation.ivi.glanceables.MediaOverlayActivity"
            android:exported="true"
            android:label="Media overlay"
            android:taskAffinity="com.test.design.overlay.media"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Design.Panel"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
        <activity
            android:name=".presentation.ivi.adaptivespace.ParkingAssistantActivity"
            android:exported="true"
            android:label="Parking assistant"
            android:taskAffinity="com.test.design.overlay.parking"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Design.Panel"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
        <activity
            android:name=".presentation.ivi.glanceables.ClimatePanelActivity"
            android:exported="true"
            android:label="@string/climate_activity_name"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:taskAffinity="com.test.design.panel.climate"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Design"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_AUTOMOTIVE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.test.design.action.OPEN_CLIMATE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
        <activity
            android:name=".presentation.ivi.glanceables.MediaPanelActivity"
            android:exported="true"
            android:label="Media player"
            android:taskAffinity="com.test.design.panel.media"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Design.Panel"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="com.test.design.action.OPEN_MEDIA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
        <!-- CarLauncher home TaskPanels. Not the in-app driving home. -->
        <activity
            android:name=".presentation.ivi.glanceables.ClimateHomePanelActivity"
            android:exported="true"
            android:label="Climate"
            android:taskAffinity="com.test.design.home.climate"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Design.Panel"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
        <activity
            android:name=".presentation.ivi.glanceables.SlideFromLeftActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.test.design.slide.left"
            android:theme="@style/Theme.Design.Panel"
            android:resizeableActivity="true">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
        <activity
            android:name=".presentation.ivi.glanceables.SlideFromRightActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.test.design.slide.right"
            android:theme="@style/Theme.Design.Panel"
            android:resizeableActivity="true">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
        <activity
            android:name=".presentation.ivi.glanceables.MediaHomePanelActivity"
            android:exported="true"
            android:label="Media"
            android:taskAffinity="com.test.design.home.media"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Design.Panel"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
        <activity
            android:name=".presentation.ivi.glanceables.VehicleHomePanelActivity"
            android:exported="true"
            android:label="Vehicle"
            android:taskAffinity="com.test.design.home.vehicle"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Design.Panel"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
        <activity
            android:name=".presentation.ivi.glanceables.VehiclePanelActivity"
            android:exported="true"
            android:label="@string/vehicle_activity_name"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:taskAffinity="com.test.design.panel.vehicle"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Design"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_AUTOMOTIVE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.test.design.action.OPEN_VEHICLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>

</manifest>

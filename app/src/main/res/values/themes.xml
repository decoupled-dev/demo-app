<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Used by Material Symbols vector drawables (android:tint="?attr/colorControlNormal"). -->
    <attr name="colorControlNormal" format="color|reference" />

    <!-- Dark window chrome by default (Compose still honors Light/System from Settings). -->
    <style name="Theme.Design" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas_background</item>
        <item name="android:colorBackground">@color/canvas_background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorControlNormal">@color/control_normal</item>
        <item name="colorControlNormal">@color/control_normal</item>
        <item name="android:forceDarkAllowed">false</item>
        <!-- Avoid stuck starting_reveal splash covering a black buffer on AAOS emulator. -->
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>

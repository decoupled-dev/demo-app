<?xml version="1.0" encoding="utf-8"?>
<!--
  Allowlist for privileged installs of com.test.design.
  Push to /system/etc/permissions/ when installing the APK under
  /system/priv-app/Design/ so climate and vehicle property reads are granted.
-->
<permissions>
    <privapp-permissions package="com.test.design">
        <permission name="android.car.permission.CONTROL_CAR_CLIMATE" />
        <permission name="android.car.permission.CONTROL_CAR_DISPLAY_UNITS" />
        <permission name="android.car.permission.READ_CAR_DISPLAY_UNITS" />
        <permission name="android.car.permission.CAR_ENERGY" />
        <permission name="android.car.permission.CAR_INFO" />
        <permission name="android.car.permission.CAR_MILEAGE" />
        <permission name="android.car.permission.CAR_TIRES" />
        <permission name="android.car.permission.CAR_SPEED" />
        <permission name="android.car.permission.CAR_POWERTRAIN" />
        <permission name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />
    </privapp-permissions>
</permissions>

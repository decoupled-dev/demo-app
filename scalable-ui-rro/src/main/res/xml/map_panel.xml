<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-bleed stock AAOS MapsPlaceholderActivity (green) under floating rail.
  Design MapActivity is not used as the map_panel host.
-->
<TaskPanel
    id="map_panel"
    controller="@xml/map_panel_controller"
    role="@array/role_map_components"
    defaultVariant="@id/opened"
    defaultLayer="@integer/map_panel_layer"
    displayId="0">

    <Restart policy="LAST" maxRetry="3" />
    <TaskBehavior
        taskProperties="UNTRIMMABLE"
        newTaskLaunchPolicy="REMAIN_IN_SOURCE" />

    <Variant id="@+id/base">
        <Layer layer="@integer/map_panel_layer" />
        <Bounds
            left="0"
            top="0"
            right="100%"
            bottom="100%" />
        <Corner radius="@dimen/map_corner_radius" />
        <Alpha alpha="1.0" />
        <Focus onTransition="false" />
    </Variant>

    <!-- Home / navigation: full-bleed under everything -->
    <Variant id="@+id/opened" parent="@id/base">
        <Visibility isVisible="true" />
    </Variant>

    <!-- Split companion: map keeps trailing remainder while app_panel resizes -->
    <Variant id="@+id/split_companion" parent="@id/base">
        <Visibility isVisible="true" />
        <Bounds
            left="40%"
            top="0"
            right="100%"
            bottom="100%" />
    </Variant>

    <Variant id="@+id/closed" parent="@id/base">
        <Visibility isVisible="false" />
    </Variant>

    <Transitions>
        <Transition
            onEvent="_System_OnHomeEvent"
            toVariant="@id/opened"
            duration="@integer/home_restore_transition_ms"
            interpolator="@android:anim/decelerate_interpolator" />
        <Transition
            onEvent="_System_TaskOpenEvent"
            onEventTokens="panelId=app_panel"
            fromVariant="@id/opened"
            toVariant="@id/closed"
            duration="@integer/panel_transition_ms"
            interpolator="@android:anim/accelerate_decelerate_interpolator" />
        <Transition
            onEvent="_System_TaskPanelEmptyEvent"
            onEventTokens="panelId=app_panel"
            fromVariant="@id/closed"
            toVariant="@id/opened"
            duration="@integer/panel_transition_ms"
            interpolator="@android:anim/decelerate_interpolator" />
        <Transition
            onEvent="_System_TaskOpenEvent"
            onEventTokens="panelId=map_panel"
            fromVariant="@id/closed"
            toVariant="@id/opened"
            duration="@integer/panel_transition_ms" />
        <!-- Zero-stutter split: map shrinks to companion lane; activity stays alive -->
        <Transition
            onEvent="@string/event_split_narrow"
            toVariant="@id/split_companion"
            duration="@integer/split_resize_transition_ms"
            interpolator="@android:anim/accelerate_decelerate_interpolator" />
        <Transition
            onEvent="@string/event_split_mid"
            toVariant="@id/split_companion"
            duration="@integer/split_resize_transition_ms"
            interpolator="@android:anim/accelerate_decelerate_interpolator" />
        <Transition
            onEvent="@string/event_split_wide"
            toVariant="@id/split_companion"
            duration="@integer/split_resize_transition_ms"
            interpolator="@android:anim/accelerate_decelerate_interpolator" />
        <Transition
            onEvent="@string/event_close_split"
            toVariant="@id/opened"
            duration="@integer/split_resize_transition_ms"
            interpolator="@android:anim/decelerate_interpolator" />
    </Transitions>
</TaskPanel>
